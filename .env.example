# Documentation des variables de la stack console maintenue.
# scripts/install.sh crée .env.console avec des secrets aléatoires et privés.
# Ne pas utiliser ce fichier comme configuration prête à démarrer : les secrets
# ci-dessous sont volontairement vides et ne doivent jamais être publiés.
EMULYTIX_POSTGRES_PASSWORD=
EMULYTIX_DATABASE_URL=
EMULYTIX_CONTROL_TOKEN=
EMULYTIX_AUTH_KEY=

# L'authentification et le second facteur sont obligatoires dans la console.
EMULYTIX_AUTH_ENABLED=true
EMULYTIX_PUBLIC_ORIGIN=http://localhost:3100
# false est réservé au localhost HTTP ; utiliser true derrière un domaine HTTPS.
EMULYTIX_COOKIE_SECURE=false

# Worker Android local, activé par docker-compose.console-worker.yml.
EMULYTIX_HOST_ID=bench-host
EMULYTIX_LEASE_TTL=30
EMULYTIX_MANAGED_IMAGE=emulytix/android-runtime:0.9.0
EMULYTIX_BENCH_IMAGE=emulytix/android-runtime:0.9.0
EMULYTIX_BENCH_NETWORK=emulytix-wf01-bench
ADB_SERVER_SOCKET=tcp:emulytix-wf01-android:5037
