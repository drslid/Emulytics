WEB_UI_PORT=3000
ORCHESTRATOR_API_PORT=8010
AGENT_SERVICE_PORT=8011
ANDROID_WEB_VNC_PORT=6080
ANDROID_ADB_PORT=5555
PUBLIC_ANDROID_EMBED_URL=http://localhost:6080/vnc.html?autoconnect=1&resize=scale&show_dot=1
ANDROID_STREAM_PROVIDER=novnc
ANDROID_STREAM_URL=http://android-runtime:6080
ANDROID_RUNTIME_CONTAINER=emulytix-android-runtime
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.4
OPENAI_ALLOWED_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.4-nano,gpt-4o-mini

# Runs persistants : activation volontaire, indépendante des sessions historiques.
# Laisser les deux valeurs vides conserve le fonctionnement existant.
# Exemple d'URL dans Compose : postgresql://emulytix:<mot-de-passe>@postgres:5432/emulytix
EMULYTIX_DATABASE_URL=
EMULYTIX_CONTROL_TOKEN=
# Requis au démarrage du profil runs ; utiliser un secret local généré.
# Ne pas publier cette valeur ni la mettre dans le dépôt.
EMULYTIX_POSTGRES_PASSWORD=
